# Copie este arquivo para .env e preencha com seus valores.
# O .env nunca deve ser enviado ao repositório.

# Chave da API da Gemini (gere em https://aistudio.google.com)
GEMINI_API_KEY=

# Opcional: modelos em ordem de preferência, separados por vírgula
# (padrão: gemini-flash-latest,gemini-3.5-flash-lite)
GEMINI_MODELOS=
